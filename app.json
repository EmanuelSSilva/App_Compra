{
  "expo": {
    "name": "Compre Agora",
    "scheme": "compreagora",
    "slug": "app-atividade",
    "owner": "emanuelssilva",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/compre-agora-icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Usamos sua localização para registrar contexto de entrega no pedido.",
        "NSUserTrackingUsageDescription": "Coletamos dados apenas para melhorar sua experiência de compra."
      }
    },
    "android": {
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "VIBRATE",
        "POST_NOTIFICATIONS",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#061B54",
        "foregroundImage": "./assets/compre-agora-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.emanuelssilva.appatividade"
    },
    "web": {
      "favicon": "./assets/compre-agora-icon.png"
    },
    "plugins": [
      "expo-sqlite",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Usamos sua localização para registrar o pedido com contexto de entrega."
        }
      ],
      "expo-notifications",
      "expo-router",
      "expo-font"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "eefdc3dd-17c8-48bf-b04d-1d03ba1e222a"
      }
    }
  }
}
